<mujoco model="stairs scene">
  <!-- Robot-AGNOSTIC staircase environment: floor + 5 static steps. Composed with
       a robot at load. (Rise 0.15 m, tread 0.30 m — humanoid-scaled.) -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="slab" rgba="0.55 0.55 0.60 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- staircase: 5 steps, rise 0.15 m, tread 0.30 m; treads at z = 0.15..0.75,
         fronts at x = 0.45, 0.75, 1.05, 1.35, 1.65 -->
    <geom name="step1" type="box" pos="1.525 0 0.075" size="1.075 0.6 0.075" material="slab"/>
    <geom name="step2" type="box" pos="1.675 0 0.150" size="0.925 0.6 0.150" material="slab"/>
    <geom name="step3" type="box" pos="1.825 0 0.225" size="0.775 0.6 0.225" material="slab"/>
    <geom name="step4" type="box" pos="1.975 0 0.300" size="0.625 0.6 0.300" material="slab"/>
    <geom name="step5" type="box" pos="2.125 0 0.375" size="0.475 0.6 0.375" material="slab"/>
  </worldbody>
</mujoco>

<mujoco model="chair scene">
  <!-- Robot-AGNOSTIC chair environment: floor + a static chair (seat + backrest),
       composed with a robot at load. Seat top at z=0.45 m (a comfortable sit height
       for a ~1.6 m humanoid), centred ~1.05 m ahead so the robot can walk up to it,
       turn, and sit down onto the seat. Static geoms sit in the worldbody, so they
       are auto-excluded from the robot penetration checks. -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="chair" rgba="0.45 0.30 0.20 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- SEAT: top surface at z=0.45, footprint x in [1.17, 1.63], y in [-0.24, 0.24].
         Placed well ahead so the robot WALKS up to it before turning and sitting. -->
    <geom name="chair_seat" type="box" pos="1.40 0 0.225" size="0.23 0.24 0.225" material="chair"/>
    <!-- BACKREST: a thin panel at the BACK edge of the seat (x=1.60), from z=0.45 to
         0.87 — behind a sitter who faces -x, so it does not collide with the torso. -->
    <geom name="chair_back" type="box" pos="1.60 0 0.66" size="0.03 0.24 0.21" material="chair"/>
  </worldbody>
</mujoco>
